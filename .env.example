# ==============================================================================
# UBAgen System Monitor — Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local testing (e.g. cp .env.example .env)
# 2. Or configure these keys in your cloud hosting dashboard (Render, Railway, Fly.io, etc.)
# 3. NEVER commit your actual '.env' file or production secrets to Git!
# ==============================================================================

# [OPTIONAL] Discord Bot Token (Server-Side Secret Only)
# Obtain from Discord Developer Portal -> Applications -> Your Bot -> Bot tab -> Reset Token
# Note: If left empty, UBAgen will start in Web Monitor mode with the Discord bot offline.
# Never expose this token in VITE_* variables or frontend code.
DISCORD_BOT_TOKEN=""

# [REQUIRED FOR BOT RESTART ENDPOINT] Server-Side Admin Bearer Token
# Required by POST /api/admin/restart-bot and the dashboard's "Restart Bot" action.
# Set a strong random secret ONLY in your server/host environment or Secrets manager.
# NEVER put this token in frontend source code, VITE_* client variables, or into HOST!
UBAGEN_ADMIN_TOKEN=""

# [OPTIONAL] Discord Development Guild (Server) ID for Instant Slash Command Sync
# Discord global slash commands can take up to 1 hour to propagate across Discord caches.
# Specifying your Server ID here makes the /stats command register INSTANTLY upon bot start.
# To find your Server ID: Enable Developer Mode in Discord User Settings -> Advanced,
# then right-click your Discord server name/icon and select "Copy Server ID".
DISCORD_GUILD_ID=""

# [OPTIONAL] Network Bind & Port Configuration
# HOST is the network bind interface address (e.g., "0.0.0.0" or "127.0.0.1").
# IMPORTANT: Do NOT set HOST to an admin token or URL; use UBAGEN_ADMIN_TOKEN for admin auth.
# PORT is the primary HTTP server port (default 8080 in Docker/production, 3000 in Node dev).
# UBAGEN_HTTP_PORT is an optional port override for the Python FastAPI service (e.g. 5050 when spawned by server.ts).
PORT=8080
HOST="0.0.0.0"
UBAGEN_HTTP_PORT=""

# [OPTIONAL] Environment Identifier
# Informational label displayed in logs and stats (e.g., "production", "staging", "docker", "render")
ENVIRONMENT="production"

# [OPTIONAL] Google Drive Credentials
# Optional path to credentials.json or JSON content for Google Drive integration.
GOOGLE_DRIVE_CREDENTIALS=""

# [OPTIONAL] Storage & Output Workspace Configuration
# Note: Container root/overlay filesystems in AI Studio Run and Cloud Run are ephemeral across
# restarts/redeploys unless backed by a mounted persistent volume or Cloud Storage FUSE / bucket.
UBAGEN_STORAGE_DIR=""
UBAGEN_OUTPUT_DIR=""
UBAGEN_TEMP_DIR=""
UBAGEN_STORAGE_MAX_GB="200"
UBAGEN_MIN_FREE_RESERVE_GB="2"
UBAGEN_OUTPUT_RETENTION_HOURS="24"
UBAGEN_PERSISTENT_VOLUME_VERIFIED="false"
UBAGEN_PUBLIC_BASE_URL=""
UBAGEN_GCS_BUCKET=""

# [OPTIONAL / PRODUCTION CLOUD RUN ENCODER] Cloud Run Job, Firestore & GCS Retention
# UBAGEN_CLOUD_RUN_JOB_NAME: Name of the dedicated Cloud Run Job worker (default below matches cloud-run-encoder-job.yaml)
# UBAGEN_GCP_PROJECT_ID: Google Cloud Project ID hosting the Cloud Run Job, Firestore & GCS Bucket
# UBAGEN_GCP_REGION: Cloud Run region (e.g. "europe-west2")
# UBAGEN_USE_FIRESTORE: Set to "true" in production so the bot service and Cloud Run Job share persistent job state
# UBAGEN_FIRESTORE_DATABASE: Firestore database ID (default: "(default)")
# UBAGEN_FIRESTORE_COLLECTION: Firestore collection name (default: "ubagen_encode_jobs")
# UBAGEN_WORKER_TEMP_DIR: Isolated scratch directory for worker torrent/FFmpeg temp files (Cloud Run writable /tmp)
# UBAGEN_ENCODE_RETENTION_SECONDS: Output retention before server-side GCS deletion (default: 7200 = 2 hours)
# UBAGEN_ALLOW_LOCAL_WORKER_FALLBACK: Set to "true" ONLY in local dev/CI when Cloud Run Job is not used (disabled in production)
# UBAGEN_DISCORD_ADMIN_IDS: Comma-separated Discord User IDs authorized to run /discord restart command
# UBAGEN_DISCORD_RESTART_MODE: "gateway" (in-process reconnect, default) or "cloud_run_revision" (triggers new Cloud Run Service revision)
UBAGEN_CLOUD_RUN_JOB_NAME="ubagen-encoder-worker"
UBAGEN_GCP_PROJECT_ID=""
UBAGEN_GCP_REGION="europe-west2"
UBAGEN_USE_FIRESTORE="true"
UBAGEN_FIRESTORE_DATABASE="(default)"
UBAGEN_FIRESTORE_COLLECTION="ubagen_encode_jobs"
UBAGEN_WORKER_TEMP_DIR="/tmp/ubagen_worker_scratch"
UBAGEN_ENCODE_RETENTION_SECONDS="7200"
UBAGEN_ALLOW_LOCAL_WORKER_FALLBACK="false"
UBAGEN_DISCORD_ADMIN_IDS=""
UBAGEN_DISCORD_RESTART_MODE="gateway"

